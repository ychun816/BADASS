# Create a bridge interface br0 (acts as a virtual switch inside this router)
# Bring br0 up
ip link add br0 type bridge
ip link set dev br0 up

# Assign IP 6.1.1.1/24 to eth1 — underlay interface (physical link to other routers)
# Bring eth1 up
ip addr add 6.1.1.1/24 dev eth1
ip link set eth1 up

# Create VXLAN tunnel interface vxlan10 using MULTICAST mode
# Difference from unicast: no "remote/local" needed — multicast handles discovery
ip link add vxlan10 type vxlan id 10 dev eth1 \
    group 239.1.1.1 dstport 4789
# Bring the VXLAN tunnel up
ip link set vxlan10 up

# Plug eth0 (host-facing interface) into the bridge
brctl addif br0 eth0

# Plug the VXLAN tunnel into the bridge
# traffic from eth0 is now tunneled over vxlan10 to ALL routers in the multicast group
# Bring eth0 up
brctl addif br0 vxlan10
ip link set eth0 up


# ## NOTES ###

#   id 10            - VXLAN Network Identifier (VNI), must match on all routers
#   dev eth1         - use eth1 as underlay (physical) interface for encapsulation
#   group 239.1.1.1  - multicast group address; all routers join this group
#                       -> so BUM traffic (Broadcast/Unknown/Multicast) is sent to ALL routers at once instead of specifying each remote manually
#   dstport 4789     - standard VXLAN UDP port


# Unicast vs Multicast:
#
#   Feature      | Unicast                    | Multicast
#   -------------|----------------------------|-------------------------------
#   remote       | explicit IP of each peer   | none needed
#   group        | none                       | 239.1.1.1 (shared group)
#   BUM traffic  | sent to one specific peer  | sent to all routers in group
#



